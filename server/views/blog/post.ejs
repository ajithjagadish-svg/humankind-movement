<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', {
  title: post.title + ' | Humankind Movement Blog',
  description: post.meta,
  keyword: post.keyword,
  canonicalPath: '/blog/' + post.slug,
  ogType: 'article',
  ogImage: post.heroImage || undefined,
  articlePublishedTime: post.publishedAt.toISOString(),
  articleSection: post.categoryLabel,
  jsonLd: {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: post.meta,
    author: { '@type': 'Person', name: 'Ajith Jagadish' },
    publisher: {
      '@type': 'Organization',
      name: 'Humankind Movement',
      logo: { '@type': 'ImageObject', url: 'https://humankindmovement.in/assets/img/logo.png' }
    },
    datePublished: post.publishedAt.toISOString(),
    dateModified: post.updatedAt.toISOString(),
    mainEntityOfPage: 'https://humankindmovement.in/blog/' + post.slug
  }
}) %>
</head>
<body>

<%- include('../partials/header') %>

<main>

  <section class="hero bg-tint">
    <div class="container-narrow">
      <span class="kicker"><%= post.categoryLabel %></span>
      <h1><%= post.title %></h1>
      <p class="note center">By Ajith Jagadish · <%= post.readMins %> min read</p>
    </div>
  </section>

  <% if (post.heroImage) { %>
    <section class="bg-white">
      <div class="container-narrow">
        <div class="media ratio-wide">
          <img src="<%= post.heroImage %>" alt="<%= post.title %>" width="960" height="600">
        </div>
      </div>
    </section>
  <% } %>

  <section class="bg-white">
    <div class="container-narrow">
      <article><%- post.bodyHtml %></article>
      <p style="margin-top:2.2em;"><a class="link-arrow" href="/blog">← Back to the Journal <span class="arrow"></span></a></p>
    </div>
  </section>

  <% if (relatedPosts.length) { %>
    <section class="bg-warm">
      <div class="container">
        <span class="kicker">More on <%= post.categoryLabel %></span>
        <h2 style="font-size:1.6rem;">Related posts</h2>
        <div class="grid-3" style="margin-top:1.6em; text-align:left;">
          <% relatedPosts.forEach(function(rp) { %>
            <div class="testimonial">
              <span class="note"><%= rp.categoryLabel %></span>
              <h3 style="margin-top:0.5em;"><a href="/blog/<%= rp.slug %>"><%= rp.title %></a></h3>
            </div>
          <% }) %>
        </div>
        <p style="margin-top:1.4em;"><a class="link-arrow" href="/blog">See all posts <span class="arrow">→</span></a></p>
      </div>
    </section>
  <% } %>

  <section class="cta-band bg-tint">
    <div class="container">
      <h2>Ready to start?</h2>
      <p class="lede center" style="margin:0 auto 1.4em;">The thinking is here. The coaching is where it becomes practice.</p>
      <div class="cta-row" style="justify-content:center;">
        <a class="btn" href="https://wa.me/919844059292?text=Hi%2C%20I%27d%20like%20to%20book%20the%20%E2%82%B91%2C000%20intro%20call." target="_blank" rel="noopener" data-ga-event="book_intro_call_click">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413A11.815 11.815 0 0012.05 0zm0 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm5.422-7.403c-.298-.149-1.759-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/></svg>
          Book Intro Call — ₹1,000
        </a>
        <a class="btn btn-ghost" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
</body>
</html>
