<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', {
  title: (outcome === 'confirmed' ? 'Subscribed' : outcome === 'unsubscribed' ? 'Unsubscribed' : 'Link not found') + ' | Humankind Movement Blog',
  description: 'Manage your Humankind Movement blog subscription.',
  canonicalPath: '/blog'
}) %>
</head>
<body>

<%- include('../partials/header') %>

<main>
  <section class="hero bg-tint">
    <div class="container-narrow">
      <% if (outcome === 'confirmed') { %>
        <h1>You're subscribed</h1>
        <p class="lede">You'll get an email whenever we publish something new in that topic. No spam, unsubscribe any time from the link in any email.</p>
      <% } else if (outcome === 'unsubscribed') { %>
        <h1>You're unsubscribed</h1>
        <p class="lede">You won't get any more notifications for that topic. You can always subscribe again from the blog.</p>
      <% } else { %>
        <h1>That link isn't valid</h1>
        <p class="lede">This confirmation or unsubscribe link has already been used, or isn't recognized. Head back to the blog to subscribe again.</p>
      <% } %>
      <p style="margin-top:1.4em;"><a class="link-arrow" href="/blog">Back to the Journal <span class="arrow">→</span></a></p>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
</body>
</html>
