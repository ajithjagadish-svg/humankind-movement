<%
// `t` (the full config/i18n.js strings object for this request's locale)
// is resolved in server/routes/blog.js and passed in via res.render() -
// EJS templates can't call require() themselves (see partials/header.ejs).
const __lang = typeof lang !== 'undefined' ? lang : 'en';
const __tFull = typeof t !== 'undefined' ? t : {};
const __t = __tFull.blog || {};
const __prefix = __lang === 'en' ? '' : '/' + __lang;
%>
<!DOCTYPE html>
<html lang="<%= __lang %>">
<head>
<%- include('../partials/head', {
  title: __t.title + ' | Humankind Movement',
  description: __t.lede.slice(0, 150),
  canonicalPath: __prefix + '/blog'
}) %>
</head>
<body>

<%- include('../partials/header', { lang: __lang, t: __tFull }) %>

<main>

  <section class="hero bg-tint">
    <div class="container-narrow">
      <span class="kicker"><%= __t.kicker %></span>
      <h1><%= __t.title %></h1>
      <p class="lede"><%= __t.lede %></p>
    </div>
  </section>

  <% categories.forEach(function(cat) { %>
    <section class="<%= cat.bg %>">
      <div class="container">
        <span class="kicker"><%= cat.label %></span>
        <h2 style="font-size:1.8rem;"><%= cat.label %></h2>
        <div class="grid-3" style="margin-top:1.6em; text-align:left;">
          <% cat.posts.forEach(function(post) { %>
            <div class="feature-card">
              <span class="note"><%= post.publishedAt.toISOString().slice(0,10) %> · <%= post.readMins %> <%= __t.minRead %></span>
              <h3 style="margin-top:0.5em;"><a href="<%= __prefix %>/blog/<%= post.slug %>"><%= post.title %></a></h3>
              <p><%= post.meta %></p>
              <p><a class="link-arrow" href="<%= __prefix %>/blog/<%= post.slug %>"><%= __t.readThePost %> <span class="arrow">→</span></a></p>
            </div>
          <% }) %>
        </div>
        <p style="margin-top:1.4em;"><a class="link-arrow" href="<%= __prefix %>/blog/topics/<%= cat.key %>"><%= __t.seeAll %> <%= cat.label %><% if (__t.posts) { %> <%= __t.posts %><% } %> <span class="arrow">→</span></a></p>
        <div style="margin-top:1.4em;">
          <%- include('../partials/blog-subscribe-widget', { categoryKey: cat.key, categoryLabel: cat.label, cadenceLabel: cat.cadenceLabel, lang: __lang }) %>
        </div>
      </div>
    </section>
  <% }) %>

</main>

<%- include('../partials/footer', { lang: __lang, t: __tFull }) %>
</body>
</html>
