<!-- Google tag (gtag.js) - script fetch deferred until first interaction or idle, to keep it off the critical rendering path -->
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-NC4HXRFPBP');

  function hkLoadGtag() {
    if (window.__hkGtagLoaded) return;
    window.__hkGtagLoaded = true;
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-NC4HXRFPBP';
    document.head.appendChild(s);
  }
  ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function (evt) {
    window.addEventListener(evt, hkLoadGtag, { once: true, passive: true });
  });
  window.addEventListener('load', function () { setTimeout(hkLoadGtag, 3000); });
</script>
