<header class="admin">
  <strong>Humankind Movement Admin</strong>
  <nav>
    <a href="/admin/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/admin/posts" class="<%= active === 'posts' ? 'active' : '' %>">Posts</a>
    <a href="/admin/content-ideas" class="<%= active === 'content-ideas' ? 'active' : '' %>">Content Ideas</a>
    <a href="/admin/carousels" class="<%= active === 'carousels' ? 'active' : '' %>">Carousels</a>
    <a href="/admin/queue" class="<%= active === 'queue' ? 'active' : '' %>">Queue</a>
    <a href="/admin/engagement" class="<%= active === 'engagement' ? 'active' : '' %>">Engagement</a>
    <a href="/admin/analytics" class="<%= active === 'analytics' ? 'active' : '' %>">Analytics</a>
    <a href="/admin/submissions" class="<%= active === 'submissions' ? 'active' : '' %>">Submissions</a>
    <form method="POST" action="/admin/logout" style="margin:0;" data-posthog-logout>
      <button type="submit">Sign out</button>
    </form>
  </nav>
  <script src="/assets/js/posthog-init.js"></script>
  <script>
    document.querySelector('[data-posthog-logout]').addEventListener('submit', function () {
      if (window.posthog && typeof window.posthog.reset === 'function') {
        window.posthog.reset();
      }
    });
  </script>
</header>
