<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Analytics | Humankind Movement Admin</title>
<%- include('../partials/admin-styles') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<style>
  .setup-steps { font-size: 0.9rem; line-height: 1.6; }
  .setup-steps code { background: var(--paper); padding: 1px 6px; border-radius: 4px; }
  .status-pill { display: inline-block; padding: 3px 10px; border-radius: 100px; font-size: 0.78rem; font-weight: 600; margin-right: 8px; }
  .status-pill.on { background: #e6f4ea; color: #1e7b34; }
  .status-pill.off { background: #f1efe9; color: #6b6862; }
  .chart-box { position: relative; height: 260px; }
  .badge.platform-instagram { background: #fbe4ef; color: #a3195b; }
  .badge.platform-linkedin { background: #e3edf7; color: #0a5fa8; }
  .badge.status-new { background: #e6f4ea; color: #1e7b34; }
  .badge.status-skipped { background: #fdecea; color: #b3261e; }
  .badge.topic { background: #f1efe9; color: #6b6862; }
</style>
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'analytics' }) %>
  <main>
    <div class="row">
      <h1 style="font-size:1.2rem; margin:0;">Analytics</h1>
      <form method="POST" action="/admin/analytics/refresh">
        <button type="submit" class="btn">Refresh now</button>
      </form>
    </div>

    <div class="card" style="margin-bottom:20px;">
      <span class="status-pill <%= configured.ga4 ? 'on' : 'off' %>">GA4 <%= configured.ga4 ? 'connected' : 'not connected' %></span>
      <span class="status-pill <%= configured.searchConsole ? 'on' : 'off' %>">Search Console <%= configured.searchConsole ? 'connected' : 'not connected' %></span>
      <% if (refreshedAt) { %>
        <p class="note" style="margin-top:0.6em;">Last refreshed <%= refreshedAt.toLocaleString() %><% if (refreshError) { %> - refresh failed: <%= refreshError %><% } %></p>
      <% } %>

      <% if (!configured.ga4 || !configured.searchConsole) { %>
        <details style="margin-top:1em;">
          <summary style="cursor:pointer; color:var(--accent); font-size:0.9rem;">
            <% if (!configured.ga4 && !configured.searchConsole) { %>Set up GA4 and Search Console<% } else if (!configured.ga4) { %>Set up GA4<% } else { %>Set up Search Console<% } %>
          </summary>
          <div class="setup-steps" style="margin-top:1em;">
            <p><strong>Both use the same Google Cloud service account</strong>, so you only create one:</p>
            <ol>
              <li>Google Cloud Console → create (or reuse) a project → APIs &amp; Services → Credentials → Create Credentials → Service Account.</li>
              <li>Open the new service account → Keys → Add Key → JSON. This downloads a file.</li>
              <li>Base64-encode that file's contents and set it as the <code>GOOGLE_SERVICE_ACCOUNT_KEY</code> environment variable in DigitalOcean (App Platform → your app → Settings → the service component → Environment variables → Encrypt it).</li>
            </ol>
            <% if (!configured.ga4) { %>
              <p style="margin-top:1em;"><strong>For GA4:</strong> in Google Analytics → Admin → Property Access Management, add the service account's email (from the JSON file, field <code>client_email</code>) as a <strong>Viewer</strong>. Then set <code>GA4_PROPERTY_ID</code> (the numeric property ID, not the G- Measurement ID) as an env var.</p>
            <% } %>
            <% if (!configured.searchConsole) { %>
              <p style="margin-top:1em;"><strong>For Search Console:</strong> in Search Console → Settings → Users and permissions, add the same service account email as a user. Then set <code>SEARCH_CONSOLE_SITE_URL</code> to exactly how your property is listed there (e.g. <code>sc-domain:humankindmovement.in</code> or <code>https://humankindmovement.in/</code>).</p>
            <% } %>
          </div>
        </details>
      <% } %>
    </div>

    <% if (configured.ga4) { %>
      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.6em;">Site Conversions (GA4 key events)</h2>
        <% if (conversionError) { %>
          <p class="note">Could not load conversion data: <%= conversionError %></p>
        <% } else if (conversions) { %>
          <p style="display:flex; gap:28px; flex-wrap:wrap; margin:0;">
            <span><strong style="font-size:1.4rem;"><%= conversions.events.book_intro_call_click %></strong><br><span class="note">Intro call clicks (₹1,000)</span></span>
            <span><strong style="font-size:1.4rem;"><%= conversions.events.contact_submit %></strong><br><span class="note">Contact form submits</span></span>
            <span><strong style="font-size:1.4rem;"><%= conversions.events.intake_submit %></strong><br><span class="note">Intake form submits</span></span>
            <span><strong style="font-size:1.4rem;"><%= conversions.events.ebook_signup %></strong><br><span class="note">Ebook signups</span></span>
            <span><strong style="font-size:1.4rem;"><%= conversions.sessions %></strong><br><span class="note">Sessions</span></span>
          </p>
          <p class="note" style="margin-top:0.8em;">All-time totals from GA4 (since tracking began). Combined conversion rate: <%= conversions.sessions > 0 ? (((conversions.events.book_intro_call_click + conversions.events.book_call_click + conversions.events.contact_submit + conversions.events.intake_submit + conversions.events.ebook_signup) / conversions.sessions) * 100).toFixed(1) + '%' : '—' %> of sessions.</p>
        <% } %>
      </div>
    <% } %>

    <% if (configured.ga4 && timeSeries && timeSeries.length) { %>
      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.6em;">Sessions, last 30 days</h2>
        <div class="chart-box"><canvas id="sessionsChart"></canvas></div>
      </div>

      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.2em;">Conversions, last 30 days</h2>
        <p class="note" style="margin:0 0 0.8em;">Same 4 key events as above, plotted as a trend instead of a total - shows whether a change (like a CTA edit) actually moved the needle, not just where things stand today.</p>
        <div class="chart-box"><canvas id="conversionsTrendChart"></canvas></div>
      </div>
    <% } %>

    <div class="card" style="margin-bottom:20px;">
      <h2 style="font-size:1rem; margin:0 0 0.6em;">Free Guide (Postpartum Recovery)</h2>
      <p style="display:flex; gap:28px; flex-wrap:wrap; margin:0;">
        <span><strong style="font-size:1.4rem;"><%= guideStats.totalViews %></strong><br><span class="note">Page views</span></span>
        <span><strong style="font-size:1.4rem;"><%= guideStats.totalSignups %></strong><br><span class="note">Signups</span></span>
        <span><strong style="font-size:1.4rem;"><%= guideStats.conversionRate === null ? '—' : (guideStats.conversionRate * 100).toFixed(1) + '%' %></strong><br><span class="note">Conversion rate</span></span>
      </p>
      <p class="note" style="margin-top:0.8em;">Tracked directly (no GA4 needed) - only counts real visitors, bots excluded. Started 2026-08-07, so this does not include any traffic before that date.</p>
    </div>

    <% if (accountSummary && accountSummary.length) { %>
      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.2em;">Social reach by account</h2>
        <p class="note" style="margin:0 0 1em;">"LinkedIn" and "Instagram" aren't single audiences - your personal profile, the Humankind Movement Page, and your personal Instagram are four separate audiences with very different reach. Same last-pull caveat as below.</p>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                <th>Account</th>
                <th>Platform</th>
                <th>Posts tracked</th>
                <th>Avg impressions/post</th>
                <th>Avg likes/post</th>
              </tr>
            </thead>
            <tbody>
              <% accountSummary.forEach(function(g) { %>
                <tr>
                  <td><%= g.account %></td>
                  <td><span class="badge platform-<%= g.platform %>"><%= g.platform %></span></td>
                  <td><%= g.posts %></td>
                  <td><%= g.avgImpressions === null ? '—' : g.avgImpressions %></td>
                  <td><%= g.avgLikes === null ? '—' : g.avgLikes %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <p class="note" style="margin-top:1em;">
          <strong>What this is actually saying (as of this pull):</strong> your personal LinkedIn profile (2,630 followers) reaches roughly 5-10x further per post than the Humankind Movement Page (10 followers) - except one carousel post that did unusually well on the Page (98 impressions, 6 clicks) despite the tiny audience, worth noticing rather than assuming personal always wins. On Instagram, the business account gets a noticeably higher engagement rate per follower than your personal account, even with fewer followers (399 vs 1,071) - likely because personal content is athlete/lifestyle, not coaching-focused, so it isn't really competing for the same attention. Practical takeaway: personal LinkedIn is doing the heavy lifting on reach right now, so it's worth keeping every coaching post there, not just the Page. The Instagram business account is converting attention efficiently for its size - growing its follower count is likely to matter more than changing what it posts.
        </p>
      </div>
    <% } %>

    <% if (configured.ga4 && socialPostsWithContext.length) { %>
      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.2em;">Social posts &amp; website traffic</h2>
        <p class="note" style="margin:0 0 1em;">
          Pulled by asking Claude to check Instagram/LinkedIn post performance - not a live feed, so this is only as current as the last pull. "vs baseline" compares the busiest of the post's first 3 days against the 30-day average daily sessions - not a statistical correlation, since a handful of posts isn't enough data for that to mean anything. Treat it as a pattern to notice, not a proven cause.
        </p>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                <th>Post</th>
                <th>Platform</th>
                <th>Published</th>
                <th>Engagement</th>
                <th>Sessions (day 0 / +1 / +2)</th>
                <th>vs baseline</th>
              </tr>
            </thead>
            <tbody>
              <% socialPostsWithContext.forEach(function(item) { %>
                <tr>
                  <td style="max-width:260px;"><a href="<%= item.post.postUrl %>" target="_blank" rel="noopener"><%= item.post.caption.length > 70 ? item.post.caption.slice(0, 70) + '…' : item.post.caption %></a></td>
                  <td><span class="badge platform-<%= item.post.platform %>"><%= item.post.platform %></span></td>
                  <td><%= new Date(item.post.publishedAt).toLocaleDateString() %></td>
                  <td class="note">
                    <%= item.post.metrics.likes %> likes<% if (item.post.metrics.comments) { %>, <%= item.post.metrics.comments %> comments<% } %><% if (item.post.metrics.shares) { %>, <%= item.post.metrics.shares %> shares<% } %><% if (item.post.metrics.impressions !== null) { %>, <%= item.post.metrics.impressions %> impressions<% } %><% if (item.post.metrics.clicks !== null && item.post.metrics.clicks !== undefined) { %>, <%= item.post.metrics.clicks %> clicks<% } %>
                  </td>
                  <td class="note">
                    <% if (item.sessionsByDay) { %>
                      <%= item.sessionsByDay.map(function(d) { return d.sessions === null ? '—' : d.sessions; }).join(' / ') %>
                    <% } else { %>—<% } %>
                  </td>
                  <td>
                    <% if (item.liftLabel === 'above baseline') { %><span class="badge status-new"><%= item.liftLabel %></span>
                    <% } else if (item.liftLabel === 'below baseline') { %><span class="badge status-skipped"><%= item.liftLabel %></span>
                    <% } else { %><span class="badge topic"><%= item.liftLabel %></span><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <% if (configured.ga4 && posts.length) { %>
      <div class="card" style="margin-bottom:20px;">
        <h2 style="font-size:1rem; margin:0 0 0.6em;">Top posts by pageviews</h2>
        <div class="chart-box"><canvas id="pageviewsChart"></canvas></div>
      </div>
    <% } %>

    <% if (configured.ga4 || configured.searchConsole) { %>
      <div class="card" style="padding:0; overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <% if (configured.ga4) { %><th>Pageviews</th><th>Avg. engagement</th><% } %>
              <% if (configured.searchConsole) { %><th>Search clicks</th><th>Impressions</th><th>CTR</th><th>Avg. position</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach(function(post) { %>
              <tr>
                <td><a href="/admin/posts/<%= post._id %>/edit"><%= post.title %></a></td>
                <% if (configured.ga4) { %>
                  <td><%= post.analytics.pageviews %></td>
                  <td><%= post.analytics.engagement %>s</td>
                <% } %>
                <% if (configured.searchConsole) { %>
                  <td><%= post.analytics.searchClicks %></td>
                  <td><%= post.analytics.searchImpressions %></td>
                  <td><%= (post.analytics.searchCtr * 100).toFixed(1) %>%</td>
                  <td><%= post.analytics.searchAvgPosition.toFixed(1) %></td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <script>
    var CHART_COLORS = ['#c0392b', '#4a90a4', '#e0a458', '#6b6862', '#1e7b34', '#8e5572'];

    <% if (configured.ga4 && timeSeries && timeSeries.length) { %>
    new Chart(document.getElementById('sessionsChart'), {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(timeSeries.map(function(d) { return d.date.slice(5); })) %>,
        datasets: [{
          label: 'Sessions',
          data: <%- JSON.stringify(timeSeries.map(function(d) { return d.sessions; })) %>,
          borderColor: '#c0392b',
          backgroundColor: 'rgba(192,57,43,0.1)',
          tension: 0.25,
          fill: true,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } },
      },
    });

    new Chart(document.getElementById('conversionsTrendChart'), {
      type: 'line',
      data: {
        labels: <%- JSON.stringify(timeSeries.map(function(d) { return d.date.slice(5); })) %>,
        datasets: [
          {
            label: 'Intro call clicks',
            data: <%- JSON.stringify(timeSeries.map(function(d) { return d.events.book_intro_call_click; })) %>,
            borderColor: CHART_COLORS[0],
            backgroundColor: CHART_COLORS[0],
            tension: 0.25,
          },
          {
            label: 'Contact submits',
            data: <%- JSON.stringify(timeSeries.map(function(d) { return d.events.contact_submit; })) %>,
            borderColor: CHART_COLORS[1],
            backgroundColor: CHART_COLORS[1],
            tension: 0.25,
          },
          {
            label: 'Intake submits',
            data: <%- JSON.stringify(timeSeries.map(function(d) { return d.events.intake_submit; })) %>,
            borderColor: CHART_COLORS[2],
            backgroundColor: CHART_COLORS[2],
            tension: 0.25,
          },
          {
            label: 'Ebook signups',
            data: <%- JSON.stringify(timeSeries.map(function(d) { return d.events.ebook_signup; })) %>,
            borderColor: CHART_COLORS[3],
            backgroundColor: CHART_COLORS[3],
            tension: 0.25,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: true, position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
      },
    });
    <% } %>

    <% if (configured.ga4 && posts.length) { %>
    (function () {
      var topPosts = <%- JSON.stringify(posts.map(function(p) { return { title: p.title, pageviews: p.analytics.pageviews || 0 }; })) %>
        .sort(function (a, b) { return b.pageviews - a.pageviews; })
        .slice(0, 10);
      new Chart(document.getElementById('pageviewsChart'), {
        type: 'bar',
        data: {
          labels: topPosts.map(function (p) { return p.title.length > 40 ? p.title.slice(0, 40) + '…' : p.title; }),
          datasets: [{ data: topPosts.map(function (p) { return p.pageviews; }), backgroundColor: '#c0392b' }],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { beginAtZero: true } },
        },
      });
    })();
    <% } %>
  </script>
</body>
</html>
