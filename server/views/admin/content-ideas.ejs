<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Content Ideas | Humankind Movement Admin</title>
<%- include('../partials/admin-styles') %>
<style>
  .idea-card { border: 1px solid var(--line); border-radius: 12px; padding: 18px; margin-bottom: 14px; }
  .idea-meta { font-size: 0.82rem; color: #6b6862; margin: 0.3em 0 0.6em; }
  .idea-links { font-size: 0.82rem; }
  .idea-links a { display: block; margin-top: 2px; }
  .idea-actions { display: flex; gap: 8px; margin-top: 12px; flex-wrap: wrap; }
  .idea-actions form { margin: 0; }
  details summary { cursor: pointer; font-size: 0.9rem; color: var(--accent); margin-bottom: 1.4em; }
  .format-badge { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.02em; text-transform: uppercase; padding: 3px 8px; border-radius: 100px; }
  .format-badge.blog-post { background: #eaf1ff; color: #2452b8; }
  .format-badge.social-content { background: #fdeee0; color: #b8622a; }
  .idea-filters { display: flex; gap: 8px; margin-bottom: 16px; }
  .idea-filters a { font-size: 0.85rem; padding: 6px 12px; border-radius: 100px; border: 1px solid var(--line); color: var(--ink-soft); }
  .idea-filters a.active { background: var(--ink); color: #fff; border-color: var(--ink); }
</style>
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'content-ideas' }) %>
  <main>
    <div class="row">
      <h1 style="font-size:1.2rem; margin:0;">Content ideas (<%= ideas.length %>)</h1>
    </div>
    <p class="idea-meta" style="margin-top:-8px;">Blog-post ideas feed the /admin/posts draft pipeline. Social-content ideas (Reels, carousels, LinkedIn posts) never become a blog post - their actual script lives on the <a href="/admin/queue">Publish Queue</a> page instead.</p>

    <div class="idea-filters">
      <a href="/admin/content-ideas" class="<%= !filterFormat ? 'active' : '' %>">All</a>
      <a href="/admin/content-ideas?format=blog-post" class="<%= filterFormat === 'blog-post' ? 'active' : '' %>">Blog posts</a>
      <a href="/admin/content-ideas?format=social-content" class="<%= filterFormat === 'social-content' ? 'active' : '' %>">Social content</a>
    </div>

    <details class="card" style="margin-bottom:20px;">
      <summary>+ Add a new content idea</summary>
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="/admin/content-ideas/new">
        <label for="topic">Topic</label>
        <input type="text" id="topic" name="topic" required>

        <label for="rationale">Why this topic (rationale, ideally citing what you found)</label>
        <textarea id="rationale" name="rationale" required style="min-height:100px; font-family:inherit;"></textarea>

        <label for="format">Is this a blog post idea or a social-content idea?</label>
        <select id="format" name="format">
          <option value="blog-post">Blog post (writes a draft in /admin/posts)</option>
          <option value="social-content">Social content (Reel, carousel, LinkedIn post - script goes on the Publish Queue)</option>
        </select>

        <label for="targetService">Which service does this support?</label>
        <select id="targetService" name="targetService">
          <option value="corporate-wellness">Corporate wellness</option>
          <option value="general-coaching">General coaching</option>
          <option value="postpartum">Postpartum</option>
          <option value="neurodivergent">Neurodivergent coaching</option>
          <option value="other">Other</option>
        </select>

        <label for="sourceLinks">Source links (one per line - only real URLs, this is what makes the idea verifiable)</label>
        <textarea id="sourceLinks" name="sourceLinks" style="min-height:80px; font-family:inherit;"></textarea>

        <div class="actions">
          <button type="submit" class="btn">Add idea</button>
        </div>
      </form>
    </details>

    <% ideas.forEach(function(idea) { %>
      <div class="idea-card">
        <div class="row" style="margin-bottom:0;">
          <h3 style="margin:0;"><%= idea.topic %></h3>
          <span class="badge <%= idea.status === 'published' ? 'published' : 'draft' %>"><%= idea.status %></span>
        </div>
        <p class="idea-meta">
          <span class="format-badge <%= idea.format || 'blog-post' %>"><%= (idea.format === 'social-content') ? 'Social content' : 'Blog post' %></span>
          For: <%= idea.targetService %>
        </p>
        <p><%= idea.rationale %></p>
        <% if (idea.sourceLinks && idea.sourceLinks.length) { %>
          <div class="idea-links">
            Sources:
            <% idea.sourceLinks.forEach(function(link) { %>
              <a href="<%= link %>" target="_blank" rel="noopener"><%= link %></a>
            <% }) %>
          </div>
        <% } %>
        <div class="idea-actions">
          <% if (idea.format !== 'social-content' && idea.status !== 'published') { %>
            <a class="btn" href="/admin/content-ideas/<%= idea._id %>/draft"><%= idea.linkedPost ? 'Review draft' : 'Write draft' %></a>
          <% } %>
          <% if (idea.format === 'social-content') { %>
            <a class="btn" href="/admin/queue">View on Publish Queue</a>
          <% } %>
          <% if (idea.status === 'idea') { %>
            <form method="POST" action="/admin/content-ideas/<%= idea._id %>/status">
              <input type="hidden" name="status" value="drafting">
              <button type="submit" class="btn btn-ghost">Mark as drafting</button>
            </form>
          <% } %>
          <form method="POST" action="/admin/carousels/generate">
            <input type="hidden" name="sourceType" value="contentIdea">
            <input type="hidden" name="sourceId" value="<%= idea._id %>">
            <button type="submit" class="btn btn-ghost">Generate carousel</button>
          </form>
          <form method="POST" action="/admin/content-ideas/<%= idea._id %>/delete" onsubmit="return confirm('Delete this idea?');">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  </main>
</body>
</html>
