<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Intake form | Humankind Movement Admin</title>
<%- include('../partials/admin-styles') %>
<style>
  h2.section-title { font-size: 0.95rem; margin: 1.6em 0 0.6em; }
  h2.section-title:first-child { margin-top: 0; }
  dl { margin: 0; }
  dt { font-size: 0.8rem; color: #6b6862; margin-top: 0.9em; }
  dd { margin: 0.2em 0 0; font-size: 0.95rem; white-space: pre-wrap; }
</style>
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'submissions' }) %>
  <main>
    <div class="row">
      <h1 style="font-size:1.2rem; margin:0;"><%= submission.fullName %></h1>
      <a href="/admin/submissions">← Back to submissions</a>
    </div>

    <div class="card">
      <p class="note">Submitted <%= submission.createdAt.toLocaleString() %></p>

      <h2 class="section-title">Basic details</h2>
      <dl>
        <dt>Email</dt><dd><a href="mailto:<%= submission.email %>"><%= submission.email %></a></dd>
        <dt>Mobile number</dt><dd><%= submission.mobileNumber %></dd>
        <dt>Date of birth</dt><dd><%= submission.dateOfBirth %></dd>
        <dt>Height</dt><dd><%= submission.height %></dd>
        <dt>Body weight (kg)</dt><dd><%= submission.bodyWeight %></dd>
        <dt>Location</dt><dd><%= submission.location %></dd>
      </dl>

      <h2 class="section-title">Safety and emergency information</h2>
      <dl>
        <dt>Emergency contact</dt><dd><%= submission.emergencyContact %></dd>
        <dt>Pregnancy or postpartum context</dt><dd><%= submission.pregnancyOrPostpartumContext || '—' %></dd>
        <dt>Health history, injuries, or medical conditions</dt><dd><%= submission.healthHistory %></dd>
        <dt>Current aches, pains, or discomfort</dt><dd><%= submission.currentPainOrDiscomfort %></dd>
      </dl>

      <h2 class="section-title">Daily rhythm and lifestyle</h2>
      <dl>
        <dt>Sleep hours</dt><dd><%= submission.sleepHours %></dd>
        <dt>Typical day</dt><dd><%= submission.typicalDay %></dd>
      </dl>

      <h2 class="section-title">Movement and activity</h2>
      <dl>
        <dt>Activity level</dt><dd><%= submission.activityLevel %></dd>
        <dt>Sport / movement practices</dt><dd><%= submission.movementPractices || '—' %></dd>
        <dt>Fitness equipment and facilities</dt><dd><%= submission.fitnessEquipment %></dd>
        <dt>Goal</dt><dd><%= submission.goal %><% if (submission.goal === 'Other' && submission.goalOther) { %> (<%= submission.goalOther %>)<% } %></dd>
      </dl>

      <h2 class="section-title">Food and lifestyle preferences</h2>
      <dl>
        <dt>Dietary preference</dt><dd><%= submission.dietaryPreference %><% if (submission.dietaryPreference === 'Other' && submission.dietaryPreferenceOther) { %> (<%= submission.dietaryPreferenceOther %>)<% } %></dd>
        <dt>Cuisine / food culture background</dt><dd><%= submission.cuisineBackground || '—' %></dd>
        <dt>Food allergies or intolerances</dt><dd><%= submission.foodAllergiesOrIntolerances || '—' %></dd>
        <dt>Current supplements</dt><dd><%= submission.currentSupplements || '—' %></dd>
        <dt>Lifestyle habits</dt><dd><%= (submission.lifestyleHabits && submission.lifestyleHabits.length) ? submission.lifestyleHabits.join(', ') : '—' %><% if (submission.lifestyleHabitsOther) { %> (<%= submission.lifestyleHabitsOther %>)<% } %></dd>
      </dl>

      <h2 class="section-title">Session preference</h2>
      <dl>
        <dt>Preferred starting point</dt><dd><%= submission.sessionPreference %></dd>
      </dl>

      <h2 class="section-title">Anything else</h2>
      <dl>
        <dt>Notes</dt><dd><%= submission.anythingElse || '—' %></dd>
      </dl>

      <h2 class="section-title">Session commitment</h2>
      <dl>
        <dt>Agreed to rescheduling policy</dt><dd><%= submission.agreesToReschedulingPolicy ? 'Yes' : 'No' %></dd>
      </dl>

      <div class="actions">
        <form method="POST" action="/admin/submissions/intake/<%= submission._id %>/delete" onsubmit="return confirm('Delete this intake form?');">
          <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </main>
</body>
</html>
