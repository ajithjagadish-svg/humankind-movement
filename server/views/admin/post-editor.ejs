<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title><%= post && post._id ? 'Edit post' : 'New post' %> | Humankind Movement Admin</title>
<%- include('../partials/admin-styles') %>
</head>
<body>
  <%- include('../partials/admin-nav', { active: 'posts' }) %>
  <main>
    <div class="row">
      <h1 style="font-size:1.2rem; margin:0;"><%= post && post._id ? 'Edit post' : 'New post' %></h1>
      <a href="/admin/posts">← Back to posts</a>
    </div>
    <div class="card">
      <% if (error) { %><div class="error"><%= error %></div><% } %>
      <form method="POST" action="<%= post && post._id ? '/admin/posts/' + post._id + '/edit' : '/admin/posts/new' %>">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required value="<%= post ? post.title || '' : '' %>">

        <label for="slug">Slug (leave blank to auto-generate from title on create)</label>
        <input type="text" id="slug" name="slug" value="<%= post ? post.slug || '' : '' %>">

        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="" disabled <%= !post || !post.category ? 'selected' : '' %>>Choose one</option>
          <% categories.forEach(function(cat) { %>
            <option value="<%= cat.key %>" <%= post && post.category === cat.key ? 'selected' : '' %>><%= cat.label %></option>
          <% }) %>
        </select>

        <label for="meta">Meta description / card blurb</label>
        <input type="text" id="meta" name="meta" value="<%= post ? post.meta || '' : '' %>">

        <label for="keyword">SEO focus keyword (optional)</label>
        <input type="text" id="keyword" name="keyword" value="<%= post ? post.keyword || '' : '' %>">

        <label for="readMins">Read time (minutes)</label>
        <input type="number" id="readMins" name="readMins" min="1" value="<%= post ? post.readMins || 2 : 2 %>">

        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="draft" <%= !post || post.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
        </select>

        <label for="bodyHtml">Post body (HTML, one &lt;p&gt; per paragraph)</label>
        <textarea id="bodyHtml" name="bodyHtml" required><%= post ? post.bodyHtml || '' : '' %></textarea>

        <label for="notes">Internal notes (not shown publicly)</label>
        <textarea id="notes" name="notes" style="min-height:80px; font-family:inherit;"><%= post ? post.notes || '' : '' %></textarea>

        <div class="actions">
          <button type="submit" class="btn"><%= post && post._id ? 'Save changes' : 'Create post' %></button>
          <a class="btn btn-ghost" href="/admin/posts">Cancel</a>
        </div>
      </form>

      <% if (post && post._id) { %>
        <form method="POST" action="/admin/posts/<%= post._id %>/delete" style="margin-top:2em;" onsubmit="return confirm('Delete this post? This cannot be undone.');">
          <button type="submit" class="btn btn-danger">Delete post</button>
        </form>
      <% } %>
    </div>
  </main>
</body>
</html>
