PORT=8080

# Added in Phase 1
MONGODB_URI=
SESSION_SECRET=

# Optional - analytics (see /admin/analytics setup instructions for how to
# get these). Both features work independently; set either or both.
GOOGLE_SERVICE_ACCOUNT_KEY=
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=

# Optional - lets the admin dashboard generate LinkedIn/Instagram carousel
# copy from a blog post or content idea via the Anthropic API. Get a key at
# console.anthropic.com (Settings -> API Keys). Without it, the "Generate
# carousel" button in the dashboard returns a clear "not configured" error.
ANTHROPIC_API_KEY=

# Optional - lets ebook/program signups (see server/config/resources.js)
# automatically email the PDF as an attachment, not just reveal a same-page
# download link. Uses Brevo's HTTP API (free tier: 300 emails/day, no card
# required) - get the key at app.brevo.com -> Settings -> API keys & MCP.
# Without it set, email delivery is skipped silently and the on-page
# download link still works.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@humankindmovement.in
BREVO_SENDER_NAME=Humankind Movement
